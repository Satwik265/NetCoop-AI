{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://netcoop.ai/schemas/envelope.json",
  "title": "AgentEnvelope",
  "description": "Standardized inter-agent communication envelope for NetCoop AI v1.0",
  "type": "object",
  "required": ["header", "payload"],
  "properties": {
    "header": {
      "type": "object",
      "required": [
        "message_id",
        "correlation_id",
        "timestamp_utc",
        "sender",
        "recipient",
        "schema_version",
        "message_type"
      ],
      "properties": {
        "message_id": {
          "type": "string",
          "format": "uuid",
          "description": "Unique identifier for this message"
        },
        "correlation_id": {
          "type": "string",
          "description": "Identifier tracking this diagnostic incident across turns"
        },
        "timestamp_utc": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 UTC timestamp of message creation"
        },
        "sender": {
          "type": "string",
          "enum": [
            "orchestrator",
            "telemetry_agent",
            "topology_agent",
            "config_agent",
            "log_agent",
            "synthesizer_agent",
            "classifier_agent",
            "human_operator"
          ],
          "description": "Identifier of the transmitting agent"
        },
        "recipient": {
          "type": "string",
          "enum": [
            "orchestrator",
            "telemetry_agent",
            "topology_agent",
            "config_agent",
            "log_agent",
            "synthesizer_agent",
            "classifier_agent",
            "broadcast"
          ],
          "description": "Identifier of intended recipient"
        },
        "schema_version": {
          "type": "string",
          "pattern": "^1\\.[0-9]+\\.[0-9]+$",
          "default": "1.0.0",
          "description": "Semantic version of the envelope schema"
        },
        "message_type": {
          "type": "string",
          "enum": [
            "telemetry_dispatch",
            "finding_submission",
            "inquiry_request",
            "inquiry_response",
            "conflict_notification",
            "synthesis_submission",
            "protocol_error"
          ],
          "description": "Functional intent of this message envelope"
        },
        "priority": {
          "type": "string",
          "enum": ["low", "normal", "high", "urgent"],
          "default": "normal"
        }
      },
      "additionalProperties": false
    },
    "payload": {
      "type": "object",
      "required": ["scope"],
      "properties": {
        "scope": {
          "type": "object",
          "required": ["network_id", "devices"],
          "properties": {
            "network_id": { "type": "string" },
            "devices": {
              "type": "array",
              "items": { "type": "string" }
            },
            "interfaces": {
              "type": "array",
              "items": { "type": "string" },
              "default": []
            }
          },
          "additionalProperties": false
        },
        "observations": {
          "type": "array",
          "description": "Raw factual discoveries extracted from telemetry or configs",
          "items": {
            "type": "object",
            "required": [
              "observation_id",
              "category",
              "entity",
              "metric_name",
              "observed_value",
              "unit",
              "severity"
            ],
            "properties": {
              "observation_id": { "type": "string" },
              "category": {
                "type": "string",
                "enum": [
                  "metric_anomaly",
                  "topology_change",
                  "config_diff",
                  "log_pattern",
                  "state_transition"
                ]
              },
              "entity": { "type": "string", "description": "e.g., spine-01:et-0/0/1" },
              "metric_name": { "type": "string" },
              "observed_value": {
                "type": ["number", "string", "boolean", "null"]
              },
              "baseline_value": {
                "type": ["number", "string", "boolean", "null"]
              },
              "unit": {
                "type": "string",
                "description": "Standardized unit e.g. bps, packets, ms, dBm, percent, count"
              },
              "severity": {
                "type": "string",
                "enum": ["info", "warning", "critical"]
              },
              "timestamp_start": { "type": ["string", "null"] },
              "timestamp_end": { "type": ["string", "null"] },
              "context": { "type": "object" },
              "provenance": { "type": ["object", "null"] },
              "confidence": { "type": ["number", "null"], "minimum": 0.0, "maximum": 1.0 },
              "data_quality": { "type": ["number", "null"], "minimum": 0.0, "maximum": 1.0 }
            },
            "additionalProperties": false
          },
          "default": []
        },
        "hypotheses": {
          "type": "array",
          "description": "Diagnoses inferred by the agent backed by observations",
          "items": {
            "type": "object",
            "required": [
              "hypothesis_id",
              "probable_cause",
              "confidence",
              "supporting_observation_ids"
            ],
            "properties": {
              "hypothesis_id": { "type": "string" },
              "probable_cause": { "type": "string" },
              "confidence": {
                "type": "number",
                "minimum": 0.0,
                "maximum": 1.0
              },
              "supporting_observation_ids": {
                "type": "array",
                "items": { "type": "string" }
              },
              "refuting_observation_ids": {
                "type": "array",
                "items": { "type": "string" },
                "default": []
              },
              "required_corroboration": {
                "type": "array",
                "items": { "type": "string" },
                "description": "Agents or signals needed to verify this hypothesis",
                "default": []
              },
              "provenance": { "type": ["object", "null"] },
              "data_quality": { "type": ["number", "null"], "minimum": 0.0, "maximum": 1.0 }
            },
            "additionalProperties": false
          },
          "default": []
        },
        "inquiries": {
          "type": "array",
          "description": "Targeted questions posed to other specialist agents",
          "items": {
            "type": "object",
            "required": [
              "inquiry_id",
              "target_agent",
              "question",
              "target_entity"
            ],
            "properties": {
              "inquiry_id": { "type": "string" },
              "target_agent": { "type": "string" },
              "question": { "type": "string" },
              "target_entity": { "type": "string" },
              "parameters": { "type": "object" },
              "answer": { "type": ["string", "object", "null"] },
              "provenance": { "type": ["object", "null"] }
            },
            "additionalProperties": false
          },
          "default": []
        },
        "raw_data": {
          "type": ["object", "null"],
          "default": null
        },
        "error": {
          "type": ["object", "null"],
          "properties": {
            "error_code": { "type": "string" },
            "message": { "type": "string" },
            "field_path": { "type": ["string", "null"] }
          },
          "required": ["error_code", "message"]
        },
        "data_quality": {
          "type": ["object", "null"]
        },
        "provenance": {
          "type": ["object", "null"]
        }
      },
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "properties": {
        "iteration": { "type": "integer", "minimum": 0, "default": 0 },
        "environment": { "type": "string", "default": "simulation" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
