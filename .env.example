# NetCoop AI Environment Configuration
# Core pipeline runs fully offline with zero LLM dependencies.
# An optional Gemini API key can be set for enhanced natural-language summaries.
GEMINI_API_KEY=

# Runtime Environment: development, testing, production
NETCOOP_ENV=development

# Server Configuration
HOST=127.0.0.1
PORT=8000
DATABASE_URL=sqlite:///./netcoop.db
LOG_LEVEL=INFO
DEBUG=false

# Internal service-to-service authentication token (minimum 16 characters; 32+ recommended for production)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_SERVICE_TOKEN=

# JWT signing secret (required in production; minimum 32 characters)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
NETCOOP_JWT_SECRET=

# Optional: comma-separated previous keys for seamless JWT secret rotation
# NETCOOP_JWT_ROTATION_SECRETS=
